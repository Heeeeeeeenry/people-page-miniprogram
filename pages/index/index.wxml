<!--pages/index/index.wxml-->
<view class="page">
  <view class="nav-header">
    <view class="nav-title">AI 助手</view>
    <view class="nav-subtitle">智能解答您的问题</view>
  </view>

  <scroll-view 
    class="msg-list" 
    style="top: {{msgListTop}}px; bottom: {{msgListBottom}}px;"
    scroll-y enhanced show-scrollbar="{{false}}" 
    scroll-into-view="{{scrollToView}}" scroll-with-animation>

    <view class="welcome-card" wx:if="{{messages.length === 0}}">
      <view class="welcome-icon">🤖</view>
      <view class="welcome-title">您好！我是智能助手</view>
      <view class="welcome-desc">有什么可以帮您的吗？</view>
      <view class="quick-actions">
        <view class="quick-btn" bindtap="quickAsk" data-text="如何写信？">如何写信？</view>
        <view class="quick-btn" bindtap="quickAsk" data-text="我要反映问题">我要反映问题</view>
        <view class="quick-btn" bindtap="quickAsk" data-text="查询信件进度">查询信件进度</view>
      </view>
    </view>

    <block wx:for="{{messages}}" wx:key="id">
      <view class="msg {{item.role}}">
        <view class="msg-avatar {{item.role}}">
          <text wx:if="{{item.role === 'assistant'}}">🤖</text>
          <text wx:else>👤</text>
        </view>
        <view class="msg-content">
          <view class="msg-bubble {{item.role}}" bindlongpress="onLongPressMsg" data-content="{{item.content}}">
            <text class="msg-text" selectable="true">{{item.content}}</text>
          </view>
          <view class="msg-actions" wx:if="{{item.hasActions}}">
            <button 
              wx:for="{{item.actions}}" wx:key="label"
              class="action-btn action-btn-primary"
              data-action="{{item}}"
              bindtap="handleAction"
            >{{item.label}}</button>
          </view>
          <view class="msg-time">{{item.time}}</view>
        </view>
      </view>
    </block>

    <view wx:if="{{loading}}" class="msg assistant">
      <view class="msg-avatar assistant"><text>🤖</text></view>
      <view class="msg-bubble assistant">
        <view class="typing-indicator">
          <view class="dot"></view><view class="dot"></view><view class="dot"></view>
        </view>
      </view>
    </view>

    <view id="msg-end" style="height: 20rpx"></view>
  </scroll-view>

  <view class="input-bar" style="bottom: {{inputBarBottom}}px;">
    <input class="input" 
           value="{{inputValue}}" bindinput="onInput" 
           placeholder="输入您的问题..." confirm-type="send" 
           bindconfirm="sendMessage" adjust-position="{{false}}"
           cursor-spacing="{{120}}" hold-keyboard="{{true}}" confirm-hold="{{true}}" />
    <view class="send-btn {{loading || !inputValue ? 'send-btn-disabled' : ''}}" catchtap="sendMessage">发送</view>
  </view>
</view>

<!-- 提交确认弹窗 -->
<view class="modal-overlay" wx:if="{{showSubmitDialog}}" bindtap="closeSubmitDialog">
  <view class="modal-card" catchtap="noop">
    <view class="modal-header">
      <text class="modal-icon">✅</text>
      <text class="modal-title">信件已为您准备好</text>
      <text class="modal-close" bindtap="closeSubmitDialog">×</text>
    </view>
    <view class="modal-body">
      <view class="preview-row">
        <text class="preview-label">群众姓名</text>
        <text class="preview-value">{{draftName}}</text>
      </view>
      <view class="preview-row">
        <text class="preview-label">手机号</text>
        <text class="preview-value">{{draftPhone}}</text>
      </view>
      <view class="preview-row">
        <text class="preview-label">身份证号</text>
        <text class="preview-value">{{draftIdCard}}</text>
      </view>
      <view class="preview-row">
        <text class="preview-label">诉求分类</text>
        <text class="preview-value">{{draftCategory}}</text>
      </view>
      <view class="preview-row">
        <text class="preview-label">诉求描述</text>
        <text class="preview-value preview-desc">{{draftDesc}}</text>
      </view>
    </view>
    <view class="modal-footer">
      <button class="modal-btn modal-btn-secondary" bindtap="handleEditDraft">修改</button>
      <button class="modal-btn modal-btn-primary" bindtap="handleSubmitDraft">确认提交</button>
    </view>
  </view>
</view>
