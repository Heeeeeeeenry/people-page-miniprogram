<!--pages/profile/profile.wxml-->
<view class="page">
  <!-- 已登录状态 -->
  <block wx:if="{{isLogin}}">
    <!-- 顶部导航栏 -->
    <view class="nav-header">
      <view class="nav-title">我的</view>
      <view class="nav-subtitle">个人中心</view>
    </view>
    
    <!-- 用户信息卡片 -->
    <view class="user-card">
      <view class="avatar-wrapper">
        <view class="avatar">👤</view>
      </view>
      <view class="user-info">
        <view class="name">{{user.name || '用户'}}</view>
        <view class="phone" wx:if="{{user.phone}}">
          <text class="phone-icon">📱</text>
          <text>{{user.phone}}</text>
        </view>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="menu-card slide-up">
      <view class="menu-title">功能服务</view>
      <view class="menu-list">
        <view class="menu-item" bindtap="onMyLetters">
          <view class="menu-icon-wrapper blue">
            <text class="menu-icon">📋</text>
          </view>
          <view class="menu-content">
            <text class="menu-text">我的信件</text>
            <text class="menu-desc">查看已提交的信件</text>
          </view>
          <view class="menu-arrow">
            <text class="arrow-icon">›</text>
          </view>
        </view>
        
        <view class="menu-item" bindtap="onContact">
          <view class="menu-icon-wrapper green">
            <text class="menu-icon">💬</text>
          </view>
          <view class="menu-content">
            <text class="menu-text">联系客服</text>
            <text class="menu-desc">遇到问题？联系我们</text>
          </view>
          <view class="menu-arrow">
            <text class="arrow-icon">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="onAbout">
          <view class="menu-icon-wrapper purple">
            <text class="menu-icon">ℹ️</text>
          </view>
          <view class="menu-content">
            <text class="menu-text">关于我们</text>
            <text class="menu-desc">了解平台信息</text>
          </view>
          <view class="menu-arrow">
            <text class="arrow-icon">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 退出登录按钮 -->
    <view class="logout-area slide-up" style="animation-delay: 0.1s;">
      <button class="logout-btn" bindtap="onLogout">
        <text class="logout-icon">🚪</text>
        <text>退出登录</text>
      </button>
    </view>
  </block>

  <!-- 未登录状态 -->
  <block wx:else>
    <view class="login-container">
      <view class="login-card slide-up">
        <view class="login-header">
          <view class="login-icon-wrapper">
            <text class="login-icon">🔐</text>
          </view>
          <view class="login-title">欢迎登录</view>
          <view class="login-desc">绑定手机号即可开始使用</view>
        </view>

        <view class="form-group">
          <view class="form-item">
            <view class="input-wrapper">
              <text class="input-icon">📱</text>
              <input class="inp" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
            </view>
          </view>

          <view class="form-item">
            <view class="code-wrapper">
              <view class="input-wrapper flex-1">
                <text class="input-icon">🔢</text>
                <input class="inp" type="number" maxlength="6" placeholder="验证码" value="{{code}}" bindinput="onCodeInput" />
              </view>
              <button class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="onSendCode" disabled="{{countdown > 0 || sending}}">
                <text wx:if="{{countdown > 0}}">{{countdown}}s</text>
                <text wx:elif="{{sending}}">发送中...</text>
                <text wx:else>获取验证码</text>
              </button>
            </view>
          </view>
        </view>

        <button class="login-btn {{!phone || code.length < 4 ? 'disabled' : ''}}" bindtap="onBindPhone" disabled="{{binding || !phone || code.length < 4}}">
          <view wx:if="{{!binding}}" class="btn-content">
            <text>立即登录</text>
          </view>
          <view wx:else class="btn-loading">
            <view class="spinner"></view>
            <text>登录中...</text>
          </view>
        </button>

        <view class="login-tips">
          <text class="tips-icon">✓</text>
          <text>登录即表示同意《用户协议》和《隐私政策》</text>
        </view>
      </view>
    </view>
  </block>
</view>
