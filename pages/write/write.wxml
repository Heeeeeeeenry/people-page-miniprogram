<!--pages/write/write.wxml-->
<view class="page">
  <!-- 顶部导航栏 -->
  <view class="nav-header">
    <view class="nav-title">写信</view>
    <view class="nav-subtitle">我们将认真处理您的每一份诉求</view>
  </view>

  <scroll-view class="scroll" scroll-y>
    <!-- 基本信息卡片 -->
    <view class="card slide-up">
      <view class="card-header">
        <view class="card-icon">📝</view>
        <view class="card-title">基本信息</view>
      </view>

      <view class="form-item">
        <view class="form-label">
          <text class="label-text">分类</text>
          <text class="label-required">*</text>
          <button wx:if="{{form.content}}" class="ai-classify-btn {{aiLoading ? 'loading' : ''}}" bindtap="doAIClassify" disabled="{{aiLoading}}" size="mini">
            {{aiLoading ? '分析中...' : '🤖 AI分类'}}
          </button>
        </view>
        <picker mode="multiSelector" range="{{categoryColumns}}" value="{{categoryIndex}}" bindchange="onCategoryChange" bindcolumnchange="onColumnChange">
          <view class="picker-value {{displayCategory ? 'has-value' : ''}}">
            <text class="picker-text">{{displayCategory || '请选择分类'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
        <view wx:if="{{aiSuggestion}}" class="ai-suggest-box">
          <text class="ai-suggest-text">{{aiSuggestion['一级分类'] || ''}}{{aiSuggestion['二级分类'] ? ' / ' + aiSuggestion['二级分类'] : ''}}{{aiSuggestion['三级分类'] ? ' / ' + aiSuggestion['三级分类'] : ''}}</text>
          <button class="ai-accept-btn" bindtap="acceptAIClassify" size="mini">采纳</button>
        </view>
      </view>

      <view class="form-item">
        <view class="form-label">
          <text class="label-text">姓名</text>
          <text class="label-required">*</text>
        </view>
        <input class="inp" value="{{form.citizen_name}}" data-field="citizen_name" bindinput="onInput" placeholder="请输入您的姓名" />
      </view>

      <view class="form-item">
        <view class="form-label">
          <text class="label-text">手机号</text>
          <text class="label-required">*</text>
        </view>
        <input class="inp" type="number" value="{{form.phone}}" data-field="phone" bindinput="onInput" placeholder="请输入手机号" maxlength="11" />
      </view>

      <view class="form-item">
        <view class="form-label">
          <text class="label-text">身份证号</text>
          <text class="label-optional">选填</text>
        </view>
        <input class="inp" type="idcard" value="{{form.id_card}}" data-field="id_card" bindinput="onInput" placeholder="请输入身份证号" />
      </view>
    </view>

    <!-- 诉求内容卡片 -->
    <view class="card slide-up" style="animation-delay: 0.1s;">
      <view class="card-header">
        <view class="card-icon">💬</view>
        <view class="card-title">诉求内容</view>
      </view>
      <textarea class="textarea" value="{{form.content}}" data-field="content" bindinput="onInput" placeholder="请详细描述您的诉求，我们会尽快处理..." maxlength="2000" auto-height />
      <view class="char-count">{{form.content ? form.content.length : 0}}/2000</view>
    </view>

    <!-- 附件卡片 -->
    <view class="card slide-up" style="animation-delay: 0.15s;">
      <view class="card-header">
        <view class="card-icon">📎</view>
        <view class="card-title">附件</view>
        <view class="card-tip">支持图片、视频、文档</view>
      </view>

      <view class="file-grid" wx:if="{{files.length > 0}}">
        <view class="file-item {{file.uploaded ? 'uploaded' : ''}}" wx:for="{{files}}" wx:for-item="file" wx:for-index="i" wx:key="path">
          <!-- 删除按钮 -->
          <view class="file-delete" data-index="{{i}}" catchtap="removeFile">×</view>

          <!-- 上传进度条 -->
          <view class="file-progress-bar" wx:if="{{!file.uploaded && file.progress > 0}}">
            <view class="file-progress-fill" style="width: {{file.progress}}%;"></view>
          </view>
          <view class="file-progress-text" wx:if="{{!file.uploaded && file.progress > 0}}">{{file.progress}}%</view>

          <!-- 图片/视频缩略图 -->
          <image wx:if="{{file.type === 'image'}}" class="file-thumb" src="{{file.path}}" mode="aspectFill" />
          <video wx:elif="{{file.type === 'video'}}" class="file-thumb" src="{{file.path}}"></video>
          <!-- 其他类型图标 -->
          <view wx:else class="file-icon-box">
            <text class="file-icon-emoji">{{file.icon}}</text>
          </view>

          <!-- 文件名 -->
          <view class="file-name">{{file.name}}</view>
          <view class="file-size">{{file.sizeText}}</view>

          <!-- 上传状态 -->
          <view class="file-status uploaded-tag" wx:if="{{file.uploaded}}">✓ 已上传</view>
          <view class="file-status uploading-tag" wx:elif="{{file.progress > 0}}">上传中...</view>
          <view class="file-status pending-tag" wx:else>待上传</view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="file-empty" wx:if="{{files.length === 0}}">
        <text class="file-empty-icon">📂</text>
        <text class="file-empty-text">添加照片、文件等附件</text>
      </view>

      <!-- 添加按钮 -->
      <view class="file-add-btn" bindtap="chooseFile">
        <text class="file-add-icon">+</text>
        <text class="file-add-text">添加附件</text>
      </view>

      <!-- 批量上传提示 -->
      <view class="file-upload-hint" wx:if="{{files.length > 0}}">
        <text>共 {{files.length}} 个文件，提交时将自动上传</text>
      </view>
    </view>

    <!-- 提示信息 -->
    <view class="tips">
      <text class="tips-icon">💡</text>
      <text class="tips-text">提交后我们会通过短信通知您处理进度</text>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-area">
      <button class="submit-btn" bindtap="onSubmit" disabled="{{loading}}">
        <view wx:if="{{!loading}}" class="btn-content">
          <text class="btn-icon">📤</text>
          <text>提交信件</text>
        </view>
        <view wx:else class="btn-loading">
          <view class="spinner"></view>
          <text>提交中...</text>
        </view>
      </button>
    </view>
  </scroll-view>
</view>
