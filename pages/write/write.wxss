/* pages/write/write.wxss - 现代化表单界面 */

.page {
  height: 100vh;
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 - 适配刘海屏 */
.nav-header {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  padding-top: calc(32rpx + env(safe-area-inset-top));
  padding-bottom: 24rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  text-align: center;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.nav-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 4rpx;
}

/* 滚动区域 */
.scroll {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.card-icon {
  font-size: 36rpx;
  width: 56rpx;
  height: 56rpx;
  background: #f5f3ff;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

/* 表单样式 */
.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.label-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.label-required {
  font-size: 24rpx;
  color: #ef4444;
}

.label-optional {
  font-size: 22rpx;
  color: #9ca3af;
  background: #f3f4f6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.inp {
  width: 100%;
  height: 92rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  font-size: 28rpx;
  color: #1e293b;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.inp:focus {
  background: #fff;
  border-color: #c7d2fe;
  box-shadow: 0 0 0 4rpx rgba(99, 102, 241, 0.1);
}

/* Picker 样式 */
.picker-value {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  font-size: 28rpx;
  color: #9ca3af;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.picker-value.has-value {
  color: #1e293b;
}

.picker-value:active {
  background: #f1f5f9;
}

.picker-arrow {
  font-size: 32rpx;
  color: #9ca3af;
  transform: rotate(90deg);
}

/* 文本域样式 */
.textarea {
  width: 100%;
  min-height: 320rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  font-size: 28rpx;
  color: #1e293b;
  box-sizing: border-box;
  line-height: 1.7;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.textarea:focus {
  background: #fff;
  border-color: #c7d2fe;
  box-shadow: 0 0 0 4rpx rgba(99, 102, 241, 0.1);
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 12rpx;
}

/* 提示信息 */
.tips {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.tips-icon {
  font-size: 28rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #6b7280;
}

/* 提交区域 */
.submit-area {
  padding: 32rpx 0 64rpx;
}

.submit-btn {
  width: 100%;
  height: 104rpx;
  line-height: 104rpx;
  border-radius: 52rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(99, 102, 241, 0.35);
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn:active {
  transform: scale(0.97);
  box-shadow: 0 6rpx 20rpx rgba(99, 102, 241, 0.25);
}

.submit-btn[disabled] {
  background: #cbd5e1;
  box-shadow: none;
}

.btn-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.btn-icon {
  font-size: 32rpx;
}

.btn-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.slide-up {
  animation: slideUp 0.5s ease-out;
}
